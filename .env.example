# 模型 API 配置（复制为 .env.local 使用；key 绝不提交仓库）
# DeepSeek 官方：  https://api.deepseek.com（key 为 sk- 开头）——默认推荐
# 阿里云百炼：    https://dashscope.aliyuncs.com/compatible-mode/v1（key 为 sk-ws- 开头）——可选
DEEPSEEK_API_KEY=sk-...
# 留空则默认使用官方端点 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方端点模型名：deepseek-v4-flash / deepseek-v4-pro；百炼端点为 deepseek-v4-flash-0731
PI_DEFAULT_MODEL=deepseek-v4-flash
# off / minimal / low / medium / high / xhigh（默认 xhigh）
PI_THINKING_LEVEL=off

# 学术检索源（可选）
# OPENALEX_API_KEY=...
# OPENALEX_MAILTO=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=...